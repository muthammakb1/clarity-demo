<script>
(function () {
  function init($) {
    $(function () {
      var $window = $(window);
      var popupTriggered = false;

      $window.on("scroll.exitIntent", function () {
        var scrollable = $(document).height() - $window.height();
        if (scrollable <= 0) return;

        var scrollPercent = ($window.scrollTop() / scrollable) * 100;
        if (scrollPercent <= 50 || popupTriggered) return;

        popupTriggered = true;
        $window.off("scroll.exitIntent");

        var triggerBtn = $(".trigger-book-free-site-visit-modal")[0];
        if (triggerBtn) triggerBtn.click();

        var dl;
        try {
          if ($(".root.responsivegrid").length &&
              window.ccAnalytics && typeof ccAnalytics.getAdobeBasePayload === "function") {
            dl = ccAnalytics.getAdobeBasePayload();
          } else if (typeof window.getAdobeBasePayload === "function") {
            dl = window.getAdobeBasePayload();
          } else if (typeof window.apDataLayer === "function") {
            dl = window.apDataLayer();
          }
        } catch (e) {}

        dl = dl || {};
        dl.event = "exit_intent_impression";
        window.adobeDataLayer = window.adobeDataLayer || [];
        window.adobeDataLayer.push(dl);
      });
    });
  }

  // Reuse the page's jQuery if present; otherwise load it and wait
  if (window.jQuery) {
    init(window.jQuery);
  } else {
    var s = document.createElement("script");
    s.src = "https://cdnjs.cloudflare.com/ajax/libs/jquery/4.0.0/jquery.min.js";
    s.onload = function () { init(window.jQuery); };
    document.head.appendChild(s);
  }
})();
</script>
