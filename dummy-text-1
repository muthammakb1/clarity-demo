<script>
(function () {
  function init($) {
    var $window = $(window);
    var popupTriggered = false;

    function getPayload() {
      try {
        if ($(".root.responsivegrid").length &&
            window.ccAnalytics && typeof ccAnalytics.getAdobeBasePayload === "function") {
          return ccAnalytics.getAdobeBasePayload();
        }
        if (typeof window.getAdobeBasePayload === "function") return window.getAdobeBasePayload();
        if (typeof window.apDataLayer === "function") return window.apDataLayer();
      } catch (e) {}
      return {};
    }

    $window.on("scroll.exitIntent", function () {
      if (popupTriggered) return;

      var scrollable = $(document).height() - $window.height();
      if (scrollable <= 0) return;

      var scrollPercent = ($window.scrollTop() / scrollable) * 100;
      if (scrollPercent <= 50) return;

      popupTriggered = true;
      $window.off("scroll.exitIntent");

      var triggerBtn = $(".trigger-book-free-site-visit-modal")[0];
      if (triggerBtn) triggerBtn.click();

      var dl = getPayload() || {};
      dl.event = "exit_intent_impression";
      window.adobeDataLayer = window.adobeDataLayer || [];
      window.adobeDataLayer.push(dl);
    });
  }

  // Wait for the site's lazy-loaded jQuery
  var tries = 0;
  (function wait() {
    if (window.jQuery) return init(window.jQuery);
    if (++tries < 50) setTimeout(wait, 200); // gives up after ~10s
  })();
})();
</script>
