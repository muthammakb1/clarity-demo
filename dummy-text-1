<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/4.0.0/jquery.min.js"></script>
<script>
$(document).ready(function () {
    const $window = $(window);
    let popupTriggered = false;
 
    $window.on("scroll", function () {
        const scrollTop = $window.scrollTop();
        const documentHeight = $(document).height();
        const windowHeight = $window.height();
 
        const scrollPercent = (scrollTop / (documentHeight - windowHeight)) * 100;
 
        if (scrollPercent > 50 && !popupTriggered) {
 
            popupTriggered = true;
 
                const triggerBtn = $('.trigger-book-free-site-visit-modal')[0];
                if (triggerBtn) {
                    triggerBtn.click();
                }
                if ($('.root.responsivegrid').length) {
                    var dl = ccAnalytics.getAdobeBasePayload ? ccAnalytics.getAdobeBasePayload() : apDataLayer();
                }
                else {
                    var dl = getAdobeBasePayload ? getAdobeBasePayload() : apDataLayer();
                }
                dl.event = "exit_intent_impression";
                window.adobeDataLayer = window.adobeDataLayer || [];
                window.adobeDataLayer.push(dl);
        }
    });
});
</script>
