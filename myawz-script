  // ---------------------------------------------------------------
  function parseCSV(text) {
    var rows = [];
    var row = [];
    var field = '';
    var inQuotes = false;
    var i = text.charCodeAt(0) === 0xFEFF ? 1 : 0;
    var len = text.length;

    for (; i < len; i++) {
      var c = text.charAt(i);

      if (inQuotes) {
        if (c === '"') {
          if (text.charAt(i + 1) === '"') {
            field += '"';
            i++;
          } else {
            inQuotes = false;
          }
        } else {
          field += c;
        }
        continue;
      }

      if (c === '"') {
        inQuotes = true;
      } else if (c === ',') {
        row.push(field);
        field = '';
      } else if (c === '\n') {
        row.push(field);
        rows.push(row);
        row = [];
        field = '';
      } else if (c === '\r') {
        // swallow; \n (or end of text) closes the row
      } else {
        field += c;
      }
    }

    if (field.length > 0 || row.length > 0) {
      row.push(field);
      rows.push(row);
    }

    return rows;
  }

  // ---------------------------------------------------------------
  // Dealer code helpers
  // ---------------------------------------------------------------
  function stripLeadingZeros(value) {
    var trimmed = String(value == null ? '' : value).trim();
    var stripped = trimmed.replace(/^0+/, '');
    return stripped.length ? stripped : (trimmed.length ? '0' : '');
  }

  function readDealerCodeFromDom() {
    var el = document.getElementById(DEALER_CODE_ELEMENT_ID);
    if (!el) return '';
    return (el.textContent || '').trim();
  }

  function waitForDealerCode() {
    return new Promise(function (resolve) {
      var existing = readDealerCodeFromDom();
      if (existing) {
        resolve(existing);
        return;
      }
      var observer = new MutationObserver(function () {
        var value = readDealerCodeFromDom();
        if (value) {
          observer.disconnect();
          resolve(value);
        }
      });
      observer.observe(document.body, { childList: true, subtree: true, characterData: true });
    });
  }

  // ---------------------------------------------------------------
  // Data loading: fetch CSV, filter by dealer code, map to GIFTS
  // ---------------------------------------------------------------
  function cell(row, index) {
    var v = row[index];
    return v == null ? '' : String(v).trim();
  }

  function buildStepsFromRow(row) {
    var rmApprovalDate = cell(row, COL.RM_APPROVAL_DATE);
    var poDate = cell(row, COL.PO_DATE);
    var dispatchDate = cell(row, COL.DISPATCH_DATE);
    var deliveryStatus = cell(row, COL.DELIVERY_STATUS);
    var isDelivered = /delivered/i.test(deliveryStatus);

    return [
      { label: 'Approved', date: rmApprovalDate, status: rmApprovalDate ? 'done' : 'pending' },
      { label: 'PO Raised', date: poDate, status: poDate ? 'done' : 'pending' },
      { label: 'Dispatched', date: dispatchDate, status: dispatchDate ? 'done' : 'pending' },
      { label: 'Delivered', date: deliveryStatus, status: isDelivered ? 'done' : 'pending' }
    ];
  }

  function fetchCsvText() {
    // Not called while RAW_ROWS is embedded — retained for switching
    // back to a live fetch once the CSV's domain is CSP-allowed.
    return fetch(CSV_URL, { credentials: 'same-origin' }).then(function (res) {
      if (!res.ok) {
        throw new Error('Failed to load gift data (HTTP ' + res.status + ')');
      }
      return res.text();
    });
  }

  function rowMonthAbbr(r) {
    // Column B looks like "Aug-25" — the part before the dash is the
    // month abbreviation the Month filter matches against.
    var raw = cell(r, COL.DATE);
    return raw.split('-')[0].trim();
  }

  function filterAndMap(rows, dealerCode, fy, monthAbbr) {
    return rows
      .filter(function (r) {
        return r.length > COL.DEALER &&
          stripLeadingZeros(r[COL.DEALER]) === dealerCode &&
          cell(r, COL.PR_YEAR) === fy &&
          rowMonthAbbr(r).toLowerCase() === monthAbbr.toLowerCase();
      })
      .map(function (r) {
        return {
          giftId: cell(r, COL.GIFT_ID),
          month: cell(r, COL.DATE),
          productName: cell(r, COL.TITLE),
          scheme: cell(r, COL.SCHEME),
          steps: buildStepsFromRow(r)
        };
      });
  }

  // Re-filters RAW_ROWS using the currently-known dealer code and
  // whatever Financial Year / Month are selected. Called on first
  // load and again whenever either dropdown selection changes.
  function applyFilters() {
    GIFTS = filterAndMap(RAW_ROWS, currentDealerCode, selectedFY, selectedMonth);
    return GIFTS;
  }

  function loadGifts() {
    return waitForDealerCode().then(function (rawDealerCode) {
      currentDealerCode = stripLeadingZeros(rawDealerCode);
      return applyFilters();
    });
  }

  // ---------------------------------------------------------------
  // Markup builders
  // ---------------------------------------------------------------
  // Dots + connecting lines live in one flat flex row (gt-dot-track):
  // dots are fixed 20px, lines are flex:1 and share the remaining
  // width equally, so the 3 segments are always the same length and
  // the last dot always lands exactly on the row's right edge — none
  // of that depends on how long any label/date text is. Labels are a
  // separate row underneath (gt-label-row), 4 equal columns, with the
  // last one right-aligned so it reads flush with the last dot.
  function buildDotTrack(steps) {
    return steps
      .map(function (step, i) {
        var isLast = i === steps.length - 1;
        var dotInner = step.status === 'done' ? ICONS.check : '';
        var dotHtml = '<div class="gt-dot ' + step.status + '">' + dotInner + '</div>';
        if (isLast) return dotHtml;
        var nextIsFilled = steps[i + 1].status === 'done' || steps[i + 1].status === 'failed';
        var lineClass = nextIsFilled ? 'gt-line done' : 'gt-line';
        return dotHtml + '<div class="' + lineClass + '"></div>';
      })
      .join('');
  }

  function buildLabelRow(steps) {
    return steps
      .map(function (step) {
        var sub = '';
        if (step.status === 'failed') {
          sub = '<div class="gt-sub failed-link">' + step.date + '</div>';
        } else if (step.date) {
          sub = '<div class="gt-sub">' + step.date + '</div>';
        }
        return (
          '<div class="gt-step-label">' +
            '<div class="gt-label ' + step.status + '">' + step.label + '</div>' +
            sub +
          '</div>'
        );
      })
      .join('');
  }

  function buildSteps(steps) {
    return (
      '<div class="gt-dot-track">' + buildDotTrack(steps) + '</div>' +
      '<div class="gt-label-row">' + buildLabelRow(steps) + '</div>'
    );
  }

  function buildCard(gift, index) {
    var hiddenClass = index >= VISIBLE_COUNT ? ' gt-hidden' : '';
    return (
      '<div class="gt-card' + hiddenClass + '" data-index="' + index + '">' +
        '<div class="gt-card-top">' +
          '<div class="gt-card-id">' + ICONS.gift + '<span>Gift ID : ' + gift.giftId + '</span></div>' +
          '<div class="gt-card-date">' + ICONS.calendar + '<span>' + gift.month + '</span></div>' +
        '</div>' +
        '<p class="gt-card-title"><b>' + gift.productName + '</b><span class="gt-scheme">Scheme : ' + gift.scheme + '</span></p>' +
        '<div class="gt-timeline">' + buildSteps(gift.steps) + '</div>' +
      '</div>'
    );
  }

  function buildListSection() {
    if (!GIFTS.length) {
      return '<div class="gt-state">No gifts found for this dealer.</div>';
    }
    var cardsHtml = GIFTS.map(buildCard).join('');
    var hasMore = GIFTS.length > VISIBLE_COUNT;
    return (
      '<div class="gt-list">' + cardsHtml + '</div>' +
      (hasMore ? '<div class="gt-more"><button type="button" data-expanded="false">Show more ' + ICONS.chevron + '</button></div>' : '')
    );
  }

  function buildFySelect() {
    var selectedOption = FY_OPTIONS.filter(function (o) { return o.value === selectedFY; })[0] || FY_OPTIONS[FY_OPTIONS.length - 1];
    var optionsHtml = FY_OPTIONS
      .map(function (o) {
        var selectedClass = o.value === selectedFY ? ' selected' : '';
        return '<div class="gt-select-option' + selectedClass + '" data-fy="' + o.value + '">' + o.label + '</div>';
      })
      .join('');
    return (
      '<div class="gt-field">' +
        '<label>Financial Year</label>' +
        '<div class="gt-select-wrap">' +
          '<div class="gt-select" data-fy-trigger><span>' + selectedOption.label + '</span>' + ICONS.chevron + '</div>' +
          '<div class="gt-select-panel" data-fy-panel>' + optionsHtml + '</div>' +
        '</div>' +
      '</div>'
    );
  }

  function buildMonthSelect() {
    var selectedOption = MONTH_OPTIONS.filter(function (o) { return o.abbr === selectedMonth; })[0] || MONTH_OPTIONS[0];
    var buttonsHtml = MONTH_OPTIONS
      .map(function (o) {
        var selectedClass = o.abbr === selectedMonth ? ' selected' : '';
        return '<button type="button" class="gt-month-btn' + selectedClass + '" data-month="' + o.abbr + '">' + o.abbr + '</button>';
      })
      .join('');
    return (
      '<div class="gt-field">' +
        '<label>Month</label>' +
        '<div class="gt-select-wrap">' +
          '<div class="gt-select" data-month-trigger><span>' + selectedOption.full + '</span>' + ICONS.chevron + '</div>' +
          '<div class="gt-month-panel" data-month-panel>' +
            '<div class="gt-month-panel-title">Select Month</div>' +
            '<div class="gt-month-grid">' + buttonsHtml + '</div>' +
          '</div>' +
        '</div>' +
      '</div>'
    );
  }

  function buildWidget(innerHtml) {
    return (
      '<div class="gt-widget">' +
        '<div class="gt-header">' +
          '<h2 class="gt-title">Gift Tracking</h2>' +
          '<a class="gt-help" href="javascript:void(0)">' + ICONS.help + ' Raise a Compliant</a>' +
        '</div>' +
        '<div class="gt-controls">' +
          buildFySelect() +
          buildMonthSelect() +
          '<div class="gt-search">' + ICONS.search + '<input type="text" placeholder="Search for a scheme or gift" /></div>' +
          '<div class="gt-updated">Last updated: <b>' + LAST_UPDATED + '</b></div>' +
        '</div>' +
        innerHtml +
      '</div>'
    );
  }

  // ---------------------------------------------------------------
  // Behaviour
  // ---------------------------------------------------------------
  function attachBehaviour(host) {
    var moreBtn = host.querySelector('.gt-more button');
    if (moreBtn) {
      moreBtn.addEventListener('click', function () {
        var hiddenCards = host.querySelectorAll('.gt-card.gt-hidden');
        hiddenCards.forEach(function (card) {
          card.classList.remove('gt-hidden');
        });
        moreBtn.closest('.gt-more').remove();
      });
    }

    var searchInput = host.querySelector('.gt-search input');
    if (searchInput) {
      searchInput.addEventListener('input', function () {
        var query = searchInput.value.trim().toLowerCase();
        host.querySelectorAll('.gt-card').forEach(function (card, i) {
          var gift = GIFTS[i];
          if (!gift) return;
          var matches =
            !query ||
            gift.giftId.toLowerCase().indexOf(query) !== -1 ||
            gift.scheme.toLowerCase().indexOf(query) !== -1;
          card.style.display = matches ? '' : 'none';
        });
      });
    }

    var fyTrigger = host.querySelector('[data-fy-trigger]');
    var fyPanel = host.querySelector('[data-fy-panel]');
    if (fyTrigger && fyPanel) {
      fyTrigger.addEventListener('click', function (e) {
        e.stopPropagation();
        fyPanel.classList.toggle('open');
      });
      fyPanel.querySelectorAll('.gt-select-option').forEach(function (opt) {
        opt.addEventListener('click', function (e) {
          e.stopPropagation();
          var fy = opt.getAttribute('data-fy');
          fyPanel.classList.remove('open');
          if (fy && fy !== selectedFY) {
            selectedFY = fy;
            applyFilters();
            renderList(host);
          }
        });
      });
    }

    var monthTrigger = host.querySelector('[data-month-trigger]');
    var monthPanel = host.querySelector('[data-month-panel]');
    if (monthTrigger && monthPanel) {
      monthTrigger.addEventListener('click', function (e) {
        e.stopPropagation();
        monthPanel.classList.toggle('open');
      });
      monthPanel.querySelectorAll('.gt-month-btn').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          var month = btn.getAttribute('data-month');
          monthPanel.classList.remove('open');
          if (month && month !== selectedMonth) {
            selectedMonth = month;
            applyFilters();
            renderList(host);
          }
        });
      });
    }
  }

  // Closes any open Financial Year / Month dropdown on an outside
  // click. Installed once (in start()) rather than per-render, since
  // host itself is never replaced — only its innerHTML is re-rendered.
  function attachOutsideClickClose(host) {
    document.addEventListener('click', function (e) {
      if (!host.isConnected) return;
      [
        { panel: '[data-fy-panel]', trigger: '[data-fy-trigger]' },
        { panel: '[data-month-panel]', trigger: '[data-month-trigger]' }
      ].forEach(function (pair) {
        var panel = host.querySelector(pair.panel);
        var trigger = host.querySelector(pair.trigger);
        if (panel && panel.classList.contains('open') && !panel.contains(e.target) && !(trigger && trigger.contains(e.target))) {
          panel.classList.remove('open');
        }
      });
    });
  }

  // ---------------------------------------------------------------
  // Mount
  // ---------------------------------------------------------------
  function renderLoading(host) {
    injectStyles();
    host.innerHTML = buildWidget('<div class="gt-state">Loading gift data…</div>');
  }

  function renderError(host, err) {
    injectStyles();
    host.innerHTML = buildWidget('<div class="gt-state gt-error">Couldn’t load gift data. ' + (err && err.message ? err.message : 'Please try again later.') + '</div>');
  }

  function renderList(host) {
    injectStyles();
    host.innerHTML = buildWidget(buildListSection());
    attachBehaviour(host);
  }

  function start(host) {
    renderLoading(host);
    attachOutsideClickClose(host);
    loadGifts()
      .then(function () {
        renderList(host);
      })
      .catch(function (err) {
        renderError(host, err);
      });
  }

  function init() {
    var host = document.querySelector(HOST_SELECTOR);
    if (host) {
      start(host);
      return;
    }
    // Angular may not have rendered the host element yet — watch for it.
    var observer = new MutationObserver(function () {
      var el = document.querySelector(HOST_SELECTOR);
      if (el) {
        observer.disconnect();
        start(el);
      }
    });
    observer.observe(document.body, { childList: true, subtree: true });
  }

  init();
})();
