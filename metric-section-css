/*
 * metric-section — "Why choose us" metrics band.
 *
 * AUTHORING (Google Doc / Word table). First row is the section header
 * (title | subtitle). Every following row is one stat:
 *   [ Icon image | Count | Label ]
 *
 *   +-------------------------------------------------------------+
 *   | metric-section                                              |
 *   +-----------------+---------+---------------------------------+
 *   | Why choose us   | Discover what sets us apart ...           |
 *   +-----------------+---------+---------------------------------+
 *   | <icon>          | 5.7L+   | Customer Homes Painted          |
 *   | <icon>          | 1200+   | Towns serviceable across india  |
 *   | <icon>          | 100%    | Dedicated site supervision      |
 *   +-----------------+---------+---------------------------------+
 *
 * Renders a heading + subheading and a row of stats (icon + big count + label),
 * marked up as a description list. Header row is optional.
 *
 * VARIANTS (add as classes on the block): none required — stats are 1-up on
 * mobile and 3-up on desktop.
 */

.metric-section {
  padding: 24px 0;
}

.metric-section-header {
  margin-bottom: 16px;
}

.metric-section-title {
  margin: 0;
  font-size: var(--heading-font-size-l);
  font-weight: 800;
  line-height: 1.15;
}

.metric-section-subtitle {
  margin: 4px 0 0;
  font-size: var(--body-font-size-xs);
  color: var(--dark-color);
}

/* --- stats --- */
.metric-section-stats {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
  margin: 0;
}

.metric-section-stat {
  margin: 0;
}

.metric-section-stat-icon {
  line-height: 0;
  margin-bottom: 8px;
}

.metric-section-stat-icon img {
  width: auto;
  height: 48px;
}

.metric-section-stat-count {
  margin: 0;
  font-family: var(--heading-font-family);
  font-size: var(--heading-font-size-l);
  font-weight: 700;
  line-height: 1.1;
  color: #5d4f43;
}

.metric-section-stat-label {
  margin: 2px 0 0;
  font-size: var(--body-font-size-s);
  color: #5d4f43;
}

/* --- tablet+ --- */
@media (width >= 600px) {
  .metric-section-stats {
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
}

/* --- desktop: header on the left, stats to the right --- */
@media (width >= 900px) {
  .metric-section {
    display: flex;
    align-items: flex-start;
    gap: 48px;
  }

  .metric-section-header {
    flex: 0 0 30%;
    max-width: 360px;
    margin-bottom: 0;
  }

  .metric-section-stats {
    flex: 1;
  }

  .metric-section-title {
    /* large display title matching the source (~70px), scaled to viewport */
    font-size: clamp(2.75rem, 4vw, 4.375rem);
    line-height: 1.05;
  }

  .metric-section-subtitle {
    font-size: var(--body-font-size-s);
  }

  .metric-section-stat-count {
    font-size: var(--heading-font-size-xl);
  }

  .metric-section-stat-label {
    font-size: var(--body-font-size-m);
  }

  .metric-section-stat-icon img {
    height: 64px;
  }
}
